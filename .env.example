# VoiceOS environment configuration (optional).
# Copy this file to .env if you need to override defaults.
# Real environment variables take precedence over .env values.

# Runtime data root. Default: %LOCALAPPDATA%\VoiceOS on Windows.
# VOICEOS_HOME=D:\VoiceOSData
# Legacy alias (still supported): VOICEOS_DATA_DIR

# Offline speech model directories (defaults shown).
# VOICEOS_KWS_MODEL_DIR=%LOCALAPPDATA%\VoiceOS\models\kws
# VOICEOS_STT_MODEL_DIR=%LOCALAPPDATA%\VoiceOS\models\stt
# VOICEOS_TTS_MODEL_DIR=%LOCALAPPDATA%\VoiceOS\models\tts

# Database and log overrides.
# VOICEOS_DB_PATH=%LOCALAPPDATA%\VoiceOS\voiceos.db
# VOICEOS_FILE_INDEX_DB_PATH=%LOCALAPPDATA%\VoiceOS\file_index.db
# VOICEOS_LOG_DIR=%LOCALAPPDATA%\VoiceOS\logs
